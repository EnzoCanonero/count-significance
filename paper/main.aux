\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \small  Discovery significance $Z = \Phi ^{-1}(1-p)$ versus observed count $n$ for the simple counting experiment with (a) $b = 0.5$ and (b) $b = 2$, testing $s_0 = 0$. The exact Poisson-tail significance (crosses) is compared to the first-order asymptotic approximation $r$ (circles) and the higher-order correction $r^*$ with continuity correction (triangles).}}{9}{}\protected@file@percent }
\newlabel{fig:rstar_pval_simple}{{3}{9}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \small  Discovery significance $Z$ versus on-region count $n$ for the on/off model with (a) $b=0.5$, $\tau =0.5$; (b) $b=0.5$, $\tau =2$; (c) $b=2$, $\tau =0.5$; (d) $b=2$, $\tau =2$, testing $s_0=0$. Each panel shows results for two values of the off-count $m$ (see text). The exact reference significance (crosses) is compared to $r$ (circles) and $r^*$ without continuity correction (triangles).}}{9}{}\protected@file@percent }
\newlabel{fig:rstar_pval_onoff}{{4}{9}}
